<Project Sdk="Microsoft.NET.Sdk">

  <!--
    "Could these rules be pasted into VHVR?" check. VHVR targets .NET Framework 4.6 with an older C# compiler, so this
    project compiles everything in src/Policies with the same limits. It produces nothing that ships; if it builds,
    the rules stay copy-pasteable into VHVR.
  -->
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>VhvrSteamFrame</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Policies\**\*.cs" LinkBase="Policies" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
